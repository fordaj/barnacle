# Platform env for macos-arm64.
# Sourced by scripts/env.sh after .common.env. Paths are relative to
# the repository root; env.sh anchors them to absolute paths. A *_BIN
# set by the caller wins over the built-in default.

PROJECT_PLATFORM="macos-arm64"

VERSIONER_BIN="${VERSIONER_BIN:-${VERSIONER_VERSION_DIR}/${PROJECT_PLATFORM}/versioner}"
LOGAMUFFIN_BIN="${LOGAMUFFIN_BIN:-${LOGAMUFFIN_VERSION_DIR}/${PROJECT_PLATFORM}/logamuffin}"
RUNNER_SPAWNER_BIN="${RUNNER_SPAWNER_BIN:-${RUNNER_SPAWNER_VERSION_DIR}/${PROJECT_PLATFORM}/runner-spawner}"
BARNACLE_BIN="${BARNACLE_BIN:-dist/${PROJECT_PLATFORM}/barnacle}"
